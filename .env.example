# 复制为 .env 后按需修改（.env 不会提交到 Git）

# 运行容器的宿主机用户（Linux 下用 `id -u` / `id -g` 查询，避免 ./data 权限问题）
PUID=1000
PGID=1000

# 镜像名：
#   本地构建：rent-utility-billing:1.1.0
#   阿里云镜像：registry.cn-hangzhou.aliyuncs.com/<命名空间>/rent-utility-billing:1.1.0
IMAGE=rent-utility-billing:1.1.0

# 映射到宿主机的端口
PORT=8787

# 可选：放在 HTTPS 反向代理后面时设为 1
# TRUST_PROXY=1

# 可选：应急兜底密码（正常用网页设置密码）
# APP_PASSWORD=

# 可选：基础镜像（网络受限时用镜像站）
# BASE_IMAGE=docker.m.daocloud.io/library/node:24-alpine
